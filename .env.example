# =====================================================================
# EDVEXA DATA QUALITY & ETL MONITOR — ENVIRONMENT CONFIGURATION
# =====================================================================

# Application Environment ('development', 'staging', 'production')
ENVIRONMENT=development
PROJECT_NAME="Edvexa Data Quality & ETL Monitor"
PORT=8010
HOST=127.0.0.1

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# Local Development (Default):
DATABASE_URL=sqlite:///./edvexa_data.db

# Hosted Production (Neon Serverless PostgreSQL):
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# DATABASE_URL=postgresql://neondb_owner:npg_sample_pass@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------
# Persistent Upload Storage Backend
# ---------------------------------------------------------------------
# Set to 'local' for local disk (uploads_storage/) or 'r2' for Cloudflare R2
STORAGE_BACKEND=local
UPLOAD_MAX_SIZE_BYTES=10485760

# Cloudflare R2 S3-Compatible Object Storage (Required when STORAGE_BACKEND=r2)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_BUCKET_NAME=edvexa-uploads
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# ---------------------------------------------------------------------
# Production Security & Administrative Reset Safeguards
# ---------------------------------------------------------------------
# In production, data reset (POST /api/dashboard/reset-data) is disabled by default
# unless an administrative token is provided or explicitly enabled.
ALLOW_DESTRUCTIVE_RESET=false
ADMIN_RESET_TOKEN=your_secure_random_admin_token_here

# ---------------------------------------------------------------------
# CORS Configuration
# ---------------------------------------------------------------------
CORS_ORIGINS=*
