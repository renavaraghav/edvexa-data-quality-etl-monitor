# =====================================================================
# EDVEXA DATA QUALITY & ETL MONITOR — ENVIRONMENT CONFIGURATION
# =====================================================================

# Application Environment ('development', 'staging', 'production')
ENVIRONMENT=development
PROJECT_NAME="Edvexa Data Quality & ETL Monitor"
PORT=8010
HOST=127.0.0.1

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# Local Development (Default):
DATABASE_URL=sqlite:///./edvexa_data.db

# Hosted Production (Neon Serverless PostgreSQL):
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# DATABASE_URL=postgresql://neondb_owner:npg_sample_pass@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------
# Persistent Upload Storage Backend
# ---------------------------------------------------------------------
# Set to 'local' for local disk (uploads_storage/) or 'neon' for Neon Object Storage
STORAGE_BACKEND=local
UPLOAD_MAX_SIZE_BYTES=10485760

# Neon S3-Compatible Object Storage (Required when STORAGE_BACKEND=neon or s3)
# NEON_STORAGE_ENDPOINT=https://your-branch.storage.ap-southeast-1.aws.neon.tech
# NEON_STORAGE_BUCKET_NAME=edvexa-uploads
# NEON_STORAGE_ACCESS_KEY_ID=your_neon_storage_access_key_id
# NEON_STORAGE_SECRET_ACCESS_KEY=your_neon_storage_secret_access_key

# ---------------------------------------------------------------------
# Production Security & Administrative Reset Safeguards
# ---------------------------------------------------------------------
# Set FORCE_DISABLE_DESTRUCTIVE_RESET=true to disable POST /api/dashboard/reset-data.
# The assignment-demo default is false, which leaves the reset endpoint enabled
# without backend login/token enforcement. Do not use this setting for sensitive data.
FORCE_DISABLE_DESTRUCTIVE_RESET=false
ADMIN_RESET_TOKEN=your_secure_random_admin_token_here

# ---------------------------------------------------------------------
# CORS Configuration
# ---------------------------------------------------------------------
CORS_ORIGINS=*
