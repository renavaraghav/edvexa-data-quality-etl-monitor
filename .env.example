# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Edvexa Data Quality & ETL Monitor"

# Database Configuration (Defaults to SQLite for local development; PostgreSQL compatible)
DATABASE_URL=sqlite:///./edvexa_data.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/edvexa_db

# File Upload Constraints
UPLOAD_MAX_SIZE_BYTES=10485760

# Server Configuration
HOST=127.0.0.1
PORT=8000
